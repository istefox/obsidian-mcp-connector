{
  "name": "mcp-tools-for-obsidian",
  "version": "2.12.0",
  "private": true,
  "description": "Expose your vault to Claude and any MCP client over the Model Context Protocol, with on-device semantic search.",
  "tags": [
    "obsidian",
    "obsidian-plugin",
    "mcp",
    "model-context-protocol",
    "claude",
    "semantic-search",
    "local-first",
    "ai-tools"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun --filter '@obsidian-mcp-tools/obsidian-plugin' build",
    "check": "tsc --noEmit && bun --filter '*' check",
    "format": "prettier --write \"packages/obsidian-plugin/src/**/*.ts\" \"packages/shared/src/**/*.ts\"",
    "format:check": "prettier --check \"packages/obsidian-plugin/src/**/*.ts\" \"packages/shared/src/**/*.ts\"",
    "dev": "bun --filter '*' dev",
    "version": "bun scripts/version.ts",
    "version:tag": "bun scripts/version.ts --tag",
    "release": "bun --filter '*' release",
    "zip": "bun --filter '*' zip"
  },
  "overrides": {
    "onnxruntime-web": "1.26.0",
    "hono": "^4.13.12",
    "fast-uri": "^3.1.2",
    "ip-address": "^10.1.1",
    "path-to-regexp": "^8.4.2",
    "protobufjs": "^7.6.5",
    "qs": "^6.15.2",
    "adm-zip": "^0.6.1",
    "sharp": "^0.35.5",
    "brace-expansion": "^5.0.12",
    "moment": "^2.31.0",
    "devalue": "^5.9.4"
  },
  "devDependencies": {
    "prettier": "^3.8.4"
  }
}
